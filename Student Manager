import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3, csv
from datetime import datetime

conn = sqlite3.connect('students.db')
cur = conn.cursor()
cur.execute("CREATE TABLE IF NOT EXISTS students (id INTEGER PRIMARY KEY, name TEXT, roll TEXT, branch TEXT, email TEXT)")
conn.commit()

def add():
    if not e1.get() or not e2.get(): return messagebox.showerror("Error","Name Roll required")
    cur.execute("INSERT INTO students (name,roll,branch,email) VALUES (?,?,?,?)",(e1.get(),e2.get(),e3.get(),e4.get()))
    conn.commit(); view()

def view():
    for i in tree.get_children(): tree.delete(i)
    for r in cur.execute("SELECT * FROM students"): tree.insert('',tk.END,values=r)

def search():
    q=e5.get()
    for i in tree.get_children(): tree.delete(i)
    for r in cur.execute("SELECT * FROM students WHERE name LIKE ?",(f'%{q}%',)): tree.insert('',tk.END,values=r)

def export():
    with open("students.csv","w",newline="") as f:
        w=csv.writer(f); w.writerow(["ID","Name","Roll","Branch","Email"])
        for r in cur.execute("SELECT * FROM students"): w.writerow(r)
    messagebox.showinfo("Done","CSV Exported")

root=tk.Tk(); root.geometry("700x400")
e1=tk.Entry(root); e2=tk.Entry(root); e3=tk.Entry(root); e4=tk.Entry(root); e5=tk.Entry(root)
tk.Label(root,text="Name").grid(row=0,column=0); e1.grid(row=0,column=1)
tk.Label(root,text="Roll").grid(row=1,column=0); e2.grid(row=1,column=1)
tk.Label(root,text="Branch").grid(row=0,column=2); e3.grid(row=0,column=3)
tk.Label(root,text="Email").grid(row=1,column=2); e4.grid(row=1,column=3)
tk.Button(root,text="Add",command=add,bg="green",fg="white").grid(row=2,column=0)
tk.Button(root,text="View",command=view).grid(row=2,column=1)
tk.Button(root,text="Export",command=export).grid(row=2,column=2)
tk.Label(root,text="Search").grid(row=3,column=0); e5.grid(row=3,column=1)
tk.Button(root,text="Search",command=search).grid(row=3,column=2)
tree=ttk.Treeview(root,columns=("ID","Name","Roll","Branch","Email"),show='headings')
for c in ("ID","Name","Roll","Branch","Email"): tree.heading(c,text=c)
tree.grid(row=4,column=0,columnspan=4); view(); root.mainloop()
